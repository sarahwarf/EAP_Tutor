# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed to GitHub.

TELEGRAM_TOKEN=your_telegram_bot_token_here
GOOGLE_SITE_URL=https://sites.google.com/view/yourcourse/home

# LLM provider — defaults to Anthropic. Leave LLM_PROVIDER unset to use Claude.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# To use OpenAI, or any OpenAI-compatible provider (DeepSeek, Qwen/Bailian,
# a local model server, OpenRouter, etc.), set:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=  # leave blank for OpenAI itself, or point at a compatible endpoint
COURSE_NAME=Your Course Name
INSTRUCTOR_NAME=Your Name
BOOKING_LINK=https://your-booking-link.com
SETUP_CODE=choose_a_private_word_or_phrase

# Optional: hardcode your Telegram ID instead of using /setup
# INSTRUCTOR_TELEGRAM_ID=your_numeric_telegram_id
